# SMS Notifications Configuration
# To enable SMS notifications:
# 1. Set SMS_ENABLED to "true"
# 2. Get Twilio credentials from https://www.twilio.com/console
# 3. Set the values below

SMS_ENABLED=false

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Phone Numbers (must include country code, e.g., +1 for USA, +1 for Canada, +972 for Israel)
# From number: The Twilio number you own or have configured
TWILIO_FROM_NUMBER=+972547535758

# To number: Your personal phone number to receive SMS notifications
SMS_NOTIFICATION_TO=+972547535758

# Other Configuration (optional)
LOG_LEVEL=INFO
