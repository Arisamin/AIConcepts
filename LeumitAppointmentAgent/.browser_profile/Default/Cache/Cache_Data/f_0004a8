    function IdNumValidationOTP(obj, args) {
        
        var validatorElement = document.getElementById("ctl00_MainContentPlaceHolder_LoginForOTP1_OTPIdNumCustomValidatorOTP");
        var textBoxElement = document.getElementById("ctl00_MainContentPlaceHolder_LoginForOTP1_OTPIdNumTextBoxOTP");
        var labelElement = document.getElementById("ctl00_MainContentPlaceHolder_LoginForOTP1_OTPIdNumLabelOTP");

        var errorMsg = "";

        if ($.trim(textBoxElement.value) == "") {
            errorMsg = "יש להזין קוד";
            textBoxElement.style.borderColor = "#f26065";
            textBoxElement.style.borderStyle = "solid";
            labelElement.style.color = "#f26065";
            if (IsFireFox())
                validatorElement.innerHTML = errorMsg;
            else
                obj.innerText = errorMsg;
            args.IsValid = false;
            return;
        }

        if (textBoxElement.value.length < 5) {
            errorMsg = "יש להקליד 5 ספרות";
            textBoxElement.style.borderColor = "#f26065";
            textBoxElement.style.borderStyle = "solid";
            labelElement.style.color = "#f26065";
            if (IsFireFox())
                validatorElement.innerHTML = errorMsg;
            else
                validatorElement.innerText = errorMsg;
            $(validatorElement).show();
            args.IsValid = false;
            return;
        }

        args.IsValid = true;
        labelElement.style.color = "";
        textBoxElement.style.borderColor = "";
        textBoxElement.style.borderStyle = "";
        return;

    }

