            myNav = new String();
            myNav = navigator.userAgent;
            if (myNav.indexOf(patExplorer3) > 0 || myNav.indexOf(patExplorer4) > 0 || myNav.indexOf(patExplorer5) > 0)
                success = true;
            else if (myNav.indexOf(patChrome) > 0)
                success = true;
            else if (myNav.indexOf(patFireFox) > 0)
                success = true;

            if (success)
                document.getElementById("divBrowserNotice").style.display = "none";
            else
                document.getElementById("divBrowserNotice").style.display = "block";
        }

        checkBrowser();

