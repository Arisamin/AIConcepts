    function IsCellPhoneNumberValid(cellPhoneNumber) {
        if ((cellPhoneNumber.indexOf("-") > -1) && (cellPhoneNumber[3] != '-'))
            return false;

        if ((cellPhoneNumber.indexOf("-") == -1) && (cellPhoneNumber.length == 11))
            return false;

        cellPhoneNumber = cellPhoneNumber.slice(0, 3) + cellPhoneNumber.slice(4);

        var cellPhonePrefixesAsOneString = document.getElementById('ctl00_MainContentPlaceHolder_LoginSiteCaptcha_HiddenFieldPhonePrefixes').value;

        var cellPhonePrefixesArray = cellPhonePrefixesAsOneString.split(",");

        for (var i = 0; i < cellPhonePrefixesArray.length; i++) {
            if (cellPhoneNumber.indexOf(cellPhonePrefixesArray[i]) == 0)
                return true;
        }
        return false;

    }

