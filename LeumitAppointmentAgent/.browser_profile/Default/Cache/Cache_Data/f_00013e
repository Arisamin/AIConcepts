var SearchByLocationManagerNewConcept = function () {
    var ScreenMode = null;

    this.mapElement = undefined;
    this.map = undefined;

    var markers = undefined;
    var tooltips = undefined;
    var object = this;

    this.zoom = 15;
    this.centerPoint;
    this.latitudeField;
    this.longitudeField;
    this.locations;
    this.allResults;
    this.renderTooltipFunc;
    this.iconUrl;
    this.searchLocationIconURL;
    this.isSearchByLocation; 
    this.userAddress;
    this.setUserPreDefinedAdress;

    this.init = function (zoom, renderTooltipFunc, securedURL, isLeftColumnControl) {     
        var iconUrl = "" + securedURL + "images/Logo1.png";
        var searchLocationIconURL = "" + securedURL + "images/MapMarker.png";
        const options = {
            componentRestrictions: { country: "il" }          
        };
        var autocomplete = new google.maps.places.Autocomplete($("[id$='txtLoaction']")[0], options);

        this.mapElement = document.getElementById('mapDiv');
        this.zoom = zoom;
        this.latitudeField = $("[id$='hfLatitude']");
        this.longitudeField = $("[id$='hfLongitude']");
        this.renderTooltipFunc = renderTooltipFunc;
        this.iconUrl = iconUrl;
        this.searchLocationIconURL = searchLocationIconURL;

        if (mobilecheck()) {
            this.ScreenMode = mobileMode;
        }
        else {
            this.ScreenMode = desktopMode;
        }
        
        $("[id$='rbLocation'], [id$='rbCities'], [id$='rbNear']").on("change", function () {           
            object.addressModeChanged();
        });

        $("[id$='txtLoaction']").on('keydown', function () {          
            $("#spanErrorLocation").hide();
            object.saveLocationInHF("", "");
        });
        $('.mapTrigger').off('click');
        $("#divCities .cityAutocomplete").removeClass("span6");
        
        if (isLeftColumnControl) {
            $("#divCities .cityAutocomplete").removeClass("control-group");
        }

       autocomplete.addListener('place_changed', () => {
           
           const result = autocomplete.getPlace();
          
            if (result.geometry !=null)
                object.saveLocationInHF(result.geometry.location.lat(), result.geometry.location.lng());
            else
                object.saveLocationInHF("", "");

            //AnalyticsManager.GooglePlacesSelectItem();
        });

        if ($.isFunction(this.ScreenMode.init))
            this.ScreenMode.init(this);
    };

    this.saveLocationInHF = function (lat, long) {
        $("[id$='hfLatitude']").val(lat);
        $("[id$='hfLongitude']").val(long);
        if (lat == "" && long == "") {
            $("#spnChooseLocationMessage").show();
        }
        else {
            $("#spnChooseLocationMessage").hide();
        }
    };
    this.getAddressBeforeSearch = function () {
        if ($("[id$='txtLoaction']").val() != '' && $("[id$='hfLatitude']").val() == '' && $("[id$='hfLongitude']").val() == '') {
            try {
                var geocoder = new google.maps.Geocoder();              
                geocoder.geocode({ 'address': $("[id$='txtLoaction']").val() }, function (results, status) {
                    if (status == 'OK') {                       
                        $("[id$='hfLatitude']").val(results[0].geometry.location.lat());
                        $("[id$='hfLongitude']").val(results[0].geometry.location.lng());
                    }
                    postBackCall();
                });
                return false;
            }
            catch (ex) {
                return true;
            }
        }
        else {
            return true;
        }
    };
   
    window.onpopstate = function (event) {
        if (event.state) {
            if (event.state.mode == 'list') {
                object.showAllResults();
            }
            else if (event.state.mode == 'map') {
                object.initializeMap();
            }
        }
        else {
            object.showAllResults();
        }
    };

    this.showResultOnMap = function (sender) {
        if (this.allResults) {
            var name = $(sender).parents(".searchResultBody").find(".name").text();
            var ID = $(sender).parents(".searchResultBody").find(".hiddenID").text().trim();
            var item = this.getResultByName(name, ID);
            var correctIndex = this.allResults.indexOf(item);
            if (this.ScreenMode == mobileMode) {
                if (this.map == undefined) {
                    this.initializeMap(correctIndex);
                }
                else {
                    this.showSpecificResult(correctIndex);
                }
            }
            else {
                this.openBigMap(name, ID);
                $(document).scrollTop($("#mapWrapper").offset().top - 20);
            }
            history.pushState({ mode: 'map' }, null, null);

        }
    };

    this.setUserPreDefinedAdress = function () {
        var geocoder = new google.maps.Geocoder();
        geocoder.geocode({ 'address': $("[id$='HiddenFieldUserAddress']").val() }, function (results, status) {
            if (status == 'OK') {
                console.log(results);
                $("[id$='hfLatitude']").val(results[0].geometry.location.lat());
                $("[id$='hfLongitude']").val(results[0].geometry.location.lng());
            }
            else {
                $("[id$='hfLatitude']").val("0");
                $("[id$='hfLongitude']").val("0");
            }
        });
    }


    this.initUserAddress =  function(event)
    {
       
        $.ajax({
            url: "Services/GetUserAddress.ashx",
            type: 'get',
            dataType: 'json',
            success: function (response, callback) {
                this.userAddress = response;

                try {
                    let city = this.userAddress.UserCity.CityName;
                    let streetName = this.userAddress.UserStreet.StreetName != null ? this.userAddress.UserStreet.StreetName : '';
                    let houseNumber = this.userAddress.HouseNumber != null ? this.userAddress.HouseNumber : '';
                    let add = '';
                    if(city!= null)
                    {
                        add = city;
                        if(streetName!= null)
                        {                           
                            if (streetName.indexOf("ת.ד.") == -1 ||
                                streetName.indexOf(".ד.נ") == -1 )
                                add = add + ', רחוב ' + streetName;
                            else
                                add = add + ', ' + streetName;                                                     
                        }
                        if(houseNumber!= null)
                        {
                            add = add + ', ' + houseNumber;
                        }
                    }
                    else
                    {
                        return true;
                    }
                    let address = this.userAddress.UserCity.CityName + ' ' +
                        this.userAddress.UserStreet.StreetName != null ? this.userAddress.UserStreet.StreetName : ''
                        + this.userAddress.HouseNumber != null ? this.userAddress.HouseNumber : '';
                    var geocoder = new google.maps.Geocoder();
                    geocoder.geocode({
                        'address': add                           
                    }, function (results, status) {
                        if (status == 'OK') {
                            $("[id$='hfLatitude']").val(results[0].geometry.location.lat());
                            $("[id$='hfLongitude']").val(results[0].geometry.location.lng());                            
                        }
                        //postBackCall();
                    });
                    return false;
                }
                catch (ex) {
                    return true;
                }
            },
            error: function (err) {
                console.log("can't get user address ");
            }
        });
    }
     

    this.addressModeChanged = function (isMobileMode, currentLocation, userAddress) {
       
        if ($("[id$='rbLocation']").is(":checked")) {
            $("#divCities input[type='hidden']").select2("val", "");
            $('.select2ClearAllCities').css('transform', 'translate(10px, -35px)');
            $('.select2ClearAllCities').attr('src', '../CSS/Images/search_city_icon.png');                                    
            $("input.fieldOneCity").prop("disabled", false);
            if (isMobileMode)
                $("[id$='txtLoaction']").val(currentLocation);
        }
        else if ($("[id$='rbCities']").is(":checked")) {               
            $("[id$='txtLoaction']").val("");
            $("[id$='hfLatitude']").val('')
            $("[id$='hfLongitude']").val('');
            $("#spanErrorLocation").hide();           
        }
        else { //by user address          
            if ($("[id$='HiddenFieldUserAddress']").val() != null &&
                $("[id$='HiddenFieldUserAddress']").val() != '') {
                this.setUserPreDefinedAdress();
            }
            else
            {
                this.initUserAddress();              
            }
            $("[id$='txtLoaction']").val("");           
            $("#spanErrorLocation").hide();
            $('#divCities').hide();
          
        }
    }

    this.saveLocations = function (locations) {
        this.locations = locations;

        this.allResults = [];
        for (var i = 0; i < locations.length; i++) {
            this.allResults = this.allResults.concat(locations[i].resultsDetails);
        }
    };

    this.openMobileMap = function () {
        if ($.isFunction(this.ScreenMode.openMobileMap))
            this.ScreenMode.openMobileMap(this);
    };

    this.maximizeMobileSearchForm = function () {
        if ($.isFunction(this.ScreenMode.maximizeMobileSearchForm))
            this.ScreenMode.maximizeMobileSearchForm();
    };

    this.showMobileResults = function () {
        if ($.isFunction(this.ScreenMode.showMobileResults))
            this.ScreenMode.showMobileResults(this);
    };

    this.onShowResults = function () {
        if ($.isFunction(this.ScreenMode.onShowResults))
            this.ScreenMode.onShowResults(this);
    };

    this.initializeMap = function (index) {
        if ($.isFunction(this.ScreenMode.initializeMap))
            this.ScreenMode.initializeMap(this,index);
    };

    this.initializeMarkers = function () {
        if ($.isFunction(this.ScreenMode.initializeMarkers))
            this.ScreenMode.initializeMarkers(this);
    };

    this.openSmallMap = function () {
        if ($.isFunction(this.ScreenMode.openSmallMap))
            this.ScreenMode.openSmallMap(this);
    };

    this.openBigMap = function (index, ID) {
        if ($.isFunction(this.ScreenMode.openBigMap))
            this.ScreenMode.openBigMap(this, index, ID);
    };

    this.maximizeSearchForm = function () {
        if ($.isFunction(this.ScreenMode.maximizeSearchForm))
            this.ScreenMode.maximizeSearchForm();
    };

    this.minimizeSearchForm = function () {
        if ($.isFunction(this.ScreenMode.minimizeSearchForm))
            this.ScreenMode.minimizeSearchForm();
    };

    this.showSpecificResult = function (index) {
        if ($.isFunction(this.ScreenMode.showSpecificResult))
            this.ScreenMode.showSpecificResult(this,index);
    };

    this.showPreviousResult = function () {
        if ($.isFunction(this.ScreenMode.showPreviousResult))
            this.ScreenMode.showPreviousResult(this);
    };

    this.showNextResult = function () {
        if ($.isFunction(this.ScreenMode.showNextResult))
            this.ScreenMode.showNextResult(this);
    };

    this.showAllResults = function () {
        if ($.isFunction(this.ScreenMode.showAllResults))
            this.ScreenMode.showAllResults(this);
    };

    this.closeAllMarkers = function () {
        for (var i = 0; i < this.tooltips.length; i++) {
            this.tooltips[i].close();
        }
    };

    this.addMarkers = function (map, locations, renderTooltipFunc, iconUrl, showTooltip) {
        var markers = [];
        var tooltips = [];
        var bounds = new google.maps.LatLngBounds(new google.maps.LatLng(29.7383259, 34.1484870), new google.maps.LatLng(33.3513509, 35.8953132));

        for (var i = 0; i < locations.length; i++) {
            var lat = locations[i].Latitude;
            var long = locations[i].Longitude;
            
            if (lat != null && long != null) {
                var myLatlng = new google.maps.LatLng(lat, long);

                if (bounds.contains(myLatlng)) {
                    var markerObj = this.addMarker(map, myLatlng, iconUrl, i);
                    markers.push(markerObj);
                    if (showTooltip) {
                        var tooltipObj = this.addTooltip(map, markerObj, renderTooltipFunc(locations[i]));
                        tooltips.push(tooltipObj);
                    }
                }
            }
        }
        return {
            markers: markers,
            tooltips: tooltips
        };
    };

    this.addMarker = function (map, point, iconUrl, index) {

        var marker = new google.maps.Marker({
            position: point,
            icon: iconUrl,
            map: map
        });
        var obj = this;
        google.maps.event.addListener(marker, 'click', function () {
            AnalyticsManager.mapMarker();
            var i;
            var results = $.grep(obj.allResults, function (e) { return obj.locations[index].Latitude == e.Latitude && obj.locations[index].Longitude == e.Longitude; });
            if (results.length > 0) {
                i = $.inArray(results[0], obj.allResults);
            }
            else
            {
                i = 0;
            }
            obj.showSpecificResult(i);
        });
        return marker;
    };

    this.addTooltip = function (map, marker, information) {
        var infowindow = new google.maps.InfoWindow({
            content: information
        });
        var obj = this;
        google.maps.event.addListener(marker, 'click', function () {
            obj.closeAllMarkers();
            infowindow.open(map, this);
        });

        return infowindow;
    };

    this.addSearchLocationMarker = function (parent) {
        var marker = new google.maps.Marker({
            position: new google.maps.LatLng(parent.latitudeField.val(), parent.longitudeField.val()),
            //icon: parent.searchLocationIconURL,
            map: parent.map
        });

    }

    this.getResultByName = function (name, ID) {
        var res = this.allResults.filter(function (item) {
            if (typeof (ID) == "undefined" || ID == "") {
                return item.Name == name;
            }
            else {
                return item.ID == ID;
            }
        });
        if (res.length > 0) {
            return res[0];
        }
        else {
            return this.allResults[0];
        }
    };
    this.closeMap = function () {
        if ($.isFunction(this.ScreenMode.closeMap))
            this.ScreenMode.closeMap();
    };
};

var mobileMode = {

    currentShownItemIndex: 0,
    searchResultsPlaceHolder: ".span12 span",

    init: function (parent) {
        var currentLocation = null;
      

        $("#divCities input[type='text']").on("focus", function () {
            $("[id$='rbCities']").prop("checked", true);
            parent.addressModeChanged(true, currentLocation);
        });
        if ($("[id$='hfLatitude']").val() == '' && $("[id$='hfLongitude']").val() == '') {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (position) {

                    var lat = position.coords.latitude;
                    var long = position.coords.longitude;
                    var point = new google.maps.LatLng(lat, long);

                    var geocoder = new google.maps.Geocoder();

                    geocoder.geocode({ 'latLng': point }, function (results, status) {
                        if (status == google.maps.GeocoderStatus.OK) {
                            currentLocation = (results[0].formatted_address);
                            if ($("[id$='rbLocation']").is(":checked")) {
                                $("[id$='txtLoaction']").val('המיקום שלי');
                                parent.saveLocationInHF(lat, long);
                            }
                        }
                    });
                });
            }
        }

        $("[id$='txtLoaction']").on("focus", function () {
            $("[id$='rbLocation']").prop("checked", true);
            parent.addressModeChanged(true, currentLocation);
        });

        $("[id$='rbLocation']").on("change", function () {
            $("[id$='txtLoaction']").val(currentLocation);
        });
    },

    openMobileMap: function (parent) {
        this.initializeMap(parent);
        history.pushState({ mode: 'map' }, null, null);
    },

    showMobileResults: function (parent) {
        this.showAllResults(parent);
        history.pushState({ mode: 'list' }, null, null);
    },

    maximizeMobileSearchForm: function () {
        if ($(".SearchSection").hasClass("mapOpened")) {
        history.pushState({ mode: 'list' }, null, null);
        }
        this.maximizeSearchForm();
    },
    onShowResults: function () {
        this.minimizeSearchForm();
        $('.mapTrigger').off('click');
    },

    maximizeSearchForm: function () {
        this.showAllResults();
        $(".searchForm").removeClass("closedSearchForm").addClass("floatedSearchForm");
        $(document).scrollTop($(".searchForm").offset().top-50);
    },
    minimizeSearchForm: function () {
        $(".searchForm").removeClass("floatedSearchForm").addClass("closedSearchForm");
    },
    initializeMap: function (parent, index) {

        var lat = parent.latitudeField.val();
        var long = parent.longitudeField.val();

        var mapOptions = {
            zoom: parent.zoom,
            center: new google.maps.LatLng(lat, long),
            zoomControl: true,
            streetViewControl: true,
            mapTypeControl: false
        };

        parent.map = new google.maps.Map(parent.mapElement, mapOptions);
        google.maps.event.addListenerOnce(parent.map, 'idle', function () {
            google.maps.event.trigger(parent.map, 'resize');
        });
        $("#mapWrapper").addClass("mobileMap");

        parent.initializeMarkers();
        this.currentShownItemIndex = 0;
        if (index != undefined)
            this.showSpecificResult(parent, index);
        else
            this.showSpecificResult(parent);
        this.minimizeSearchForm();
    },

    initializeMarkers: function (parent) {
        if (parent.locations != undefined) {
            var markersObj = parent.addMarkers(parent.map, parent.locations, parent.renderTooltipFunc, parent.iconUrl, false);
            parent.markers = markersObj.markers;
            parent.tooltips = markersObj.tooltips;
        }
    },

    showSpecificResult: function (parent, index, direction) {
        this.minimizeSearchForm();
        if (typeof index !== "undefined" && index != null) {
            this.currentShownItemIndex = index;
            this.checkIndexValidity(parent);
        }
        var currentItem = parent.allResults[this.currentShownItemIndex];
        $(".SearchSection").addClass("mapOpened expandOnScreen").removeClass("mapClosed");
        var outObj = {};
        var inObj = {};
        var cssObj = {};
        if (direction == 'right') {
            outObj = { left: '-' + $(window).width() + 'px' };
            inObj = { right: '0px' };
            cssObj = { left: 'auto', right: '-' + $(window).width() + 'px' };
        }
        else {
            outObj = { right: '-' + $(window).width() + 'px' };
            inObj = { left: '0px' };
            cssObj = { right: 'auto', left: '-' + $(window).width() + 'px' };
        }

        var lat = currentItem.Latitude;
        var long = currentItem.Longitude;
        var currentMode = this;
        $("#currentResultDetails").css({ left: 'auto', right: 'auto' }).animate(outObj, 500, function () {
            $(".currentResultName").html(currentItem.Name);
            $(".currentResultAddress").html(currentItem.Address);
            if (lat != 0 && long != 0) {
                $(".currentResultDistance").html("מרחק: " + currentItem.Distance.toFixed(2) + " ק\"מ").show();
            }
            else {
                $(".currentResultDistance").hide();
            }
            $(".currentResultPhone").html(currentItem.Phone);
            $(".currentResultServiceType").html(currentItem.ServiceType);
            $("#mapWrapper").height($(".singleResultPager").position().top - $(".searchForm").height());
            $("#currentResultDetails").css(cssObj).animate(inObj, 500, function () {
                $(".searchResultsTitle," + currentMode.searchResultsPlaceHolder + ", .searchResultsTable").hide();
                if (parent.allResults.length > 1) {
                    $(".mapResultPager").show();
                    if (currentMode.currentShownItemIndex == 0) {
                        $(".mapResultPager.Prev").hide();
                    }
                    else if (currentMode.currentShownItemIndex == parent.allResults.length - 1) {
                        $(".mapResultPager.Next").hide();
                    }
                }
                else {
                    $(".mapResultPagerWrapper").hide();
                }
                
                $(".currentResultNavigate").on('click', function () {
                    currentMode.goToWaze(lat, long)
                });
                if (lat != 0 && long != 0) {
                    parent.map.setCenter(new google.maps.LatLng(lat, long));
                }
                else {
                    alert('לא ניתן להציג את המיקום במפה');
                }
            });
        });
       
       
    },

    goToWaze: function (lat, long) {
        window.location.href = "waze://?ll=" + lat + "," + long + "&navigate=yes"; 
    },

    showNextResult: function (parent) {
        this.currentShownItemIndex++;
        this.checkIndexValidity(parent);
        this.showSpecificResult(parent, null, 'left');
    },

    showPreviousResult: function (parent) {
        this.currentShownItemIndex--;
        this.checkIndexValidity(parent);
        this.showSpecificResult(parent, null, 'right');
    },

    showAllResults: function (parent) {
        $(".SearchSection").addClass("mapClosed").removeClass("mapOpened expandOnScreen");
        $(".searchResultsTitle," + this.searchResultsPlaceHolder + ", .searchResultsTable").show();
        $("#mapWrapper").removeClass("mobileMap").height(0);
        this.minimizeSearchForm();

        this.currentShownItemIndex = 0;
    },
    checkIndexValidity: function (parent) {
        var resultsCount = parent.allResults.length - 1;

        if (this.currentShownItemIndex == -1)
            this.currentShownItemIndex = resultsCount;
        if (this.currentShownItemIndex > resultsCount)
            this.currentShownItemIndex = 0;
    }
};

var desktopMode = {
    currentShownItemIndex: 0,
    init: function () {
        if (isPostBack == "False" && $("[id$='rbLocation']").is(":checked") == false) {
            $("[id$='hfLatitude'] , [id$='hfLongitude']").val('');
            $("[id$='txtLoaction']").attr('disabled', true);
        }
        else {
            validateCheckBox();
        }

        $("[id$='rbLocation'], [id$='rbCities']").on("change", function () {
            validateCheckBox();
        });

        function validateCheckBox() {
            try{
                if ($("[id$='rbLocation']").is(":checked")) {
                    $("[id$='txtLoaction']").removeAttr('disabled');
                    $("#divCities input[type='hidden']").select2("disable");
                    $("input.fieldOneCity").prop("disabled", true);
                }
                if ($("[id$='rbCities']").is(":checked")) {
                    $("[id$='hfLatitude'] , [id$='hfLongitude']").val('');
                    $("[id$='txtLoaction']").attr('disabled', true);
                    $("#divCities input[type='hidden']").select2('enable');
                    $("input.fieldOneCity").prop("disabled", false);
                    $("#spanErrorLocation").hide();
                    $("#divCities").find(".select2-choices").css("pointer-events", "all");
                   // $("#mapWrapper, .mapButton").hide();
                }
            }
            catch(ex)
            {
                location.href = location.href;
            }
        }
    },

    onShowResults: function (parent) {
        parent.initializeMap();
    },

    initializeMap: function (parent) {
        if ($("[id$='rbLocation']").is(":checked"))
            this.openSmallMap(parent);
    },

    initializeMarkers: function (parent) {
        if (parent.locations != undefined) {
            var markersObj = parent.addMarkers(parent.map, parent.locations, parent.renderTooltipFunc, parent.iconUrl, true);
            parent.markers = markersObj.markers;
            parent.tooltips = markersObj.tooltips;

            google.maps.event.addListener(parent.map, "click", function () { parent.closeAllMarkers(); });
        }
    },

    openSmallMap: function (parent) {
        $("#mapWrapper").removeClass("bigMap").addClass("smallMap");
        $(".searchForm").show();
        $(".reduceDiv").hide();
        $(".enlargeDiv").show();
        $(".closeDiv").hide();

        var lat = parent.latitudeField.val();
        var long = parent.longitudeField.val();

       
        var mapOptions = {
            zoom: parent.zoom,
            center: new google.maps.LatLng(lat, long),
            draggableCursor: 'pointer',
            zoomControl: false,
            streetViewControl: false,
            mapTypeControl: false
        };

        parent.map = new google.maps.Map(parent.mapElement, mapOptions);

        $(parent.mapElement).on("click", { currentObj: this, parent: parent }, function (e) {
            e.data.currentObj.openBigMap(e.data.parent, 0);
        });
    },

    openBigMap: function (parent, name, ID) {
        $("#mapWrapper").removeClass("smallMap").addClass("bigMap");
        $(".searchForm").hide();        
        if (parent.isSearchByLocation && typeof (name) == "undefined") {
            $(".reduceDiv").show();
            $(".closeDiv").hide();
        }
        else {
            $(".closeDiv").show();
            $(".reduceDiv").hide();
        }
        $(".enlargeDiv").hide();
        var lat, long;
        if (typeof (name) == "undefined") {
            lat = parent.latitudeField.val();
            long = parent.longitudeField.val();
        }
        else {
            var currentItem = parent.getResultByName(name, ID);
            lat = currentItem.Latitude;
            long = currentItem.Longitude;
        }
        var zoom = parent.zoom;
        if (lat == '' && long == '') {
            lat = '31.0460510';
            long = '34.8516120';
            zoom = 8;
        }
   
        var mapOptions = {
            zoom: zoom,
            center: new google.maps.LatLng(lat, long),
            zoomControl: true,
            streetViewControl: true,
            mapTypeControl: false
        };

        parent.map = new google.maps.Map(parent.mapElement, mapOptions);
        parent.initializeMarkers();
        if (parent.isSearchByLocation) {
            parent.addSearchLocationMarker(parent);
        }
        $(parent.mapElement).off("click");
    },
    
    closeMap: function () {
        $("#mapWrapper").removeClass("bigMap").removeClass("smallMap");
